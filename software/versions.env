# --- main (PIONEER-Experiment/main, develop-testbeam) -----------------------
# main d9f9306: reco_testbeam a174ef9 (bad SMA frame cuts, reco_testbeam PR #25) on
# top of the RelWithDebInfo default in CMakeLists.txt (release/nearline-2026-10-03).
MAIN_SHA=d9f930607d4bdc63b2ef5c750f108405cdcea857
# The submodule commits d9f9306 records; install.sh checks the clone against them.
MAIN_SUBMODULES=(
    "shared        55eacb341f49771a6d6dfe38c0bb6b3cf0b1f9ec"
    "MonteCarlo    78ba60fcb7c2a28209cd99ba6a45fa3b3bd543cf"
    "DetResponse   39366f0acdbfb8455182e35b2f45eeb9782bc8d6"
    "Reco          fc79bef8225ed9b71b952ca5b00c7ec1b62a8d4f"
    "geometry      2bcda87c290b7cb5b8e2a6a5472a5f9e023e7ff3"
    "analyser      b45a2a9b4c3bf52f6ffa7bddc8f1696d03c1bc4b"
    "reco_testbeam a174ef9fc4ac0ad441db9a81f7137317adc3182d"
)
# pinky's BUILD_* flags: BUILD_REC, BUILD_TESTBEAM, BUILD_SHARED, BUILD_TESTING
# on; BUILD_MC, BUILD_DER off (setup.sh -o sets BUILD_REC, -t BUILD_TESTBEAM,
# BUILD_DER defaults to OFF, BUILD_MC has to be switched off by hand).
MAIN_SETUP_ARGS="-b -e -o -t"
# RelWithDebInfo (-O2 -g -DNDEBUG): setup.sh sets no build type. main's
# CMakeLists.txt turns an empty one into RelWithDebInfo from
# release/nearline-2026-10-03 on; an older main compiles it without optimisation
# (about 2.3x the CPU per job, same output), so the flag stays explicit here.
# Pinky's rebuild command (software/README.md, "Rebuild main on pinky") passes
# the same two flags.
MAIN_CMAKE_FLAGS="-DBUILD_MC=OFF -DCMAKE_BUILD_TYPE=RelWithDebInfo"

# --- Fedora 44 RPMs: pinky's exact builds -----------------------------------
# One line per package: "name epoch version release arch source-rpm-NVR sigmd5".
# sigmd5 is pinky's `rpm -q --qf '%{SIGMD5}'`: install.sh accepts a package,
# downloaded or on the host, only when its header digest is exactly this.
# 127 packages: the 109 pinky RPMs the reference builds actually use (every
# /usr path in the five CMakeCache.txt files, the gcc dependency files, the
# link lines, and ldd of the installed ROOT/Gaudi/CLHEP/MIDAS/main libraries;
# scratch/piana-software/reference/rpms_used.txt), plus the dependency closure
# of the ones piana lacks and of python3-numpy/python3-pip (dnf, no weak deps,
# on a piana-like Fedora 44). Every NVR is pinky's (rpm -qa, 2026-09-30).
# install.sh uses the host's copy when the host has exactly this NVR and
# unpacks pinky's build into the sysroot otherwise.
