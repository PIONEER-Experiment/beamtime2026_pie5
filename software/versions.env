# Toolchain and base-system packages. If the host has another build of one of
# these, install.sh warns but does NOT put pinky's into the sysroot: a second
# glibc, libstdc++ or python next to the host's compiler and interpreter would
# be worse than the version difference. Such a host is not a parity host.
# Fedora 44 signing key (short id), for koji's signed-copy path
# packages/<src>/<ver>/<rel>/data/signed/<keyid>/<arch>/<file>.
FEDORA_KEYID=6d9f90a6

RPMS_HOST_ONLY_RE='^(glibc|glibc-devel|glibc-common|kernel-headers|gcc|gcc-c\+\+|cpp|binutils|coreutils|filesystem|bash|make|git-core|gdb|gdb-headless|libgcc|libstdc\+\+|libstdc\+\+-devel|libatomic|libgomp|libquadmath|libxcrypt|python3|python3-libs|systemd-libs|openssl-libs|pkgconf-pkg-config)$'
